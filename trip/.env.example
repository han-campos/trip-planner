# Passcode gate. Client-visible by design; this is a lightweight shared-guest gate, not auth.
VITE_TRIP_PASSCODE=bimpeangel2026

# Optional shared backend. Leave blank for no-setup localStorage fallback.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional server endpoint for future AI trip fill-in. Must be a Supabase Edge Function or other server endpoint.
VITE_AI_ENDPOINT_URL=

VITE_DEBUG=false
